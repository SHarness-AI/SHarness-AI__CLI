{
 "pbp": 1,
 "profile": "newsroom-agent",
 "title": "the newsroom agent: reads a vault, writes one output folder, reaches its sites",
 "version": 1,
 "notes": "P3 as a profile: reads the vault and the output, writes only the output.",
 "blanks": {
  "workspace": null,
  "sites": [
   "send.sgraph.ai"
  ],
  "secrets": [],
  "memory_mb": 1024,
  "pids": 64
 },
 "template": {
  "pbp": 1,
  "id": "newsroom-agent",
  "layer": "invocation",
  "notes": "P3 as a profile: reads the vault and the output, writes only the output.",
  "files": {
   "read": [
    "/usr",
    "/lib",
    "/lib64",
    "/bin",
    "/sbin",
    "/etc",
    "$workspace",
    "$workspace/out"
   ],
   "write": [
    "$workspace/out"
   ],
   "exec": [
    "/usr",
    "/lib",
    "/lib64",
    "/bin",
    "/sbin"
   ]
  },
  "network": {
   "sites": "$sites"
  },
  "secrets": "$secrets",
  "process": {
   "no_new_privs": true,
   "max_memory_mb": "$memory_mb",
   "max_pids": "$pids"
  }
 }
}
